{
  "protocol_version": "controlled-cross-model-v2",
  "split_seed": 42,
  "resize_mode": "letterbox",
  "hvangle_split_mode": "patient",
  "image_size": 224,
  "batch_size": 16,
  "num_workers": 4,
  "amp": true,
  "max_epochs": 60,
  "patience": 10,
  "seeds": [
    17,
    42,
    73
  ],
  "tolerances_by_target": {
    "cobb": [
      5.0
    ],
    "hva": [
      5.0
    ],
    "ima": [
      3.0
    ]
  },
  "hvangle_unilateral_only": true,
  "search_space": [
    {
      "lr": 0.0001,
      "weight_decay": 0.0001
    },
    {
      "lr": 0.0003,
      "weight_decay": 0.0001
    },
    {
      "lr": 0.0001,
      "weight_decay": 0.001
    }
  ],
  "models": {
    "efficientnet_b0": {
      "family": "timm",
      "architecture": "efficientnet_b0",
      "pretraining": "imagenet",
      "adaptation": "full_finetune"
    },
    "convnext_tiny": {
      "family": "timm",
      "architecture": "convnext_tiny",
      "pretraining": "imagenet",
      "adaptation": "full_finetune"
    },
    "vit_b16": {
      "family": "timm",
      "architecture": "vit_base_patch16_224",
      "pretraining": "imagenet",
      "adaptation": "full_finetune"
    },
    "biomedclip_probe": {
      "family": "biomedclip",
      "architecture": "BiomedCLIP-PubMedBERT-ViT-B16",
      "pretraining": "biomedical",
      "adaptation": "frozen_mlp_probe"
    },
    "medimageinsight_probe": {
      "family": "medimageinsight",
      "architecture": "MedImageInsight-v1",
      "pretraining": "medical",
      "adaptation": "frozen_mlp_probe"
    },
    "medclip_vit_probe": {
      "family": "medclip_vit",
      "architecture": "MedCLIP-Swin",
      "pretraining": "medical_vision_language",
      "adaptation": "frozen_mlp_probe",
      "checkpoint": "checkpoints/MedCLIP/vit/pytorch_model.bin"
    },
    "medsam_encoder_probe": {
      "family": "medsam_encoder",
      "architecture": "MedSAM-ViT-B-image-encoder",
      "pretraining": "medical_segmentation",
      "adaptation": "frozen_mlp_probe",
      "checkpoint": "cvpr/checkpoints/medsam_vit_b.pth"
    }
  }
}
